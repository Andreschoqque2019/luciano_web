# URL del backend Express
# Desarrollo local:
VITE_API_URL=http://localhost:4000
# En Vercel (producción): dejar vacío para usar mismo origen (/api)
# o poner la URL completa del deploy si el backend está separado:
# VITE_API_URL=https://tu-proyecto.vercel.app

# Panel /admin — contraseña del backend (solo referencia local)
# El valor real vive en BACKEND/.env como ADMIN_PASSWORD y se valida
# en GET /api/solicitudes vía header x-admin-password o ?admin=
# Ejemplo para probar el panel en local:
# ADMIN_PASSWORD=cambia-esta-clave-en-produccion
